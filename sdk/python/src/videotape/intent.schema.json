{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A named action; `on` makes it an action on each item of that record (or of the items a field\nholds, where the frame holds the record more than once), `to` a move.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Phrase"
            },
            {
              "$ref": "#/$defs/FieldRef"
            }
          ],
          "title": "Label"
        },
        "target": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "back": "#/$defs/Back",
                  "call": "#/$defs/Call",
                  "copy": "#/$defs/Copy",
                  "done": "#/$defs/Done",
                  "download": "#/$defs/Download",
                  "goto": "#/$defs/Goto",
                  "jump": "#/$defs/Jump",
                  "open": "#/$defs/Open",
                  "stay": "#/$defs/Stay"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Jump"
                },
                {
                  "$ref": "#/$defs/Goto"
                },
                {
                  "$ref": "#/$defs/Back"
                },
                {
                  "$ref": "#/$defs/Stay"
                },
                {
                  "$ref": "#/$defs/Call"
                },
                {
                  "$ref": "#/$defs/Done"
                },
                {
                  "$ref": "#/$defs/Open"
                },
                {
                  "$ref": "#/$defs/Download"
                },
                {
                  "$ref": "#/$defs/Copy"
                }
              ]
            },
            {
              "$ref": "#/$defs/HandlerRef"
            }
          ],
          "title": "Target"
        },
        "affordance": {
          "enum": [
            "press",
            "move"
          ],
          "title": "Affordance",
          "type": "string"
        },
        "on": {
          "title": "On",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FieldRef"
            }
          ]
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "gesture": {
          "title": "Gesture",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "enum": [
            "heading",
            "primary",
            "secondary",
            "navigation",
            "status",
            "supporting"
          ],
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "enum": [
            "required",
            "normal",
            "optional"
          ],
          "type": "string"
        },
        "hidden": {
          "$ref": "#/$defs/FieldRef"
        },
        "visible": {
          "$ref": "#/$defs/FieldRef"
        }
      },
      "required": [
        "label",
        "target",
        "affordance"
      ],
      "title": "Action",
      "type": "object"
    },
    "After": {
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "then": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "back": "#/$defs/Back",
                  "call": "#/$defs/Call",
                  "copy": "#/$defs/Copy",
                  "done": "#/$defs/Done",
                  "download": "#/$defs/Download",
                  "goto": "#/$defs/Goto",
                  "jump": "#/$defs/Jump",
                  "open": "#/$defs/Open",
                  "stay": "#/$defs/Stay"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Jump"
                },
                {
                  "$ref": "#/$defs/Goto"
                },
                {
                  "$ref": "#/$defs/Back"
                },
                {
                  "$ref": "#/$defs/Stay"
                },
                {
                  "$ref": "#/$defs/Call"
                },
                {
                  "$ref": "#/$defs/Done"
                },
                {
                  "$ref": "#/$defs/Open"
                },
                {
                  "$ref": "#/$defs/Download"
                },
                {
                  "$ref": "#/$defs/Copy"
                }
              ]
            },
            {
              "$ref": "#/$defs/HandlerRef"
            }
          ],
          "title": "Then"
        }
      },
      "required": [
        "seconds",
        "then"
      ],
      "title": "After",
      "type": "object"
    },
    "Back": {
      "additionalProperties": false,
      "properties": {
        "sign_in": {
          "title": "Sign In"
        },
        "sign_out": {
          "title": "Sign Out",
          "const": true,
          "type": "boolean"
        },
        "type": {
          "const": "back",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Back",
      "type": "object"
    },
    "Call": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "call",
          "title": "Type",
          "type": "string"
        },
        "tape": {
          "pattern": "^[A-Za-z][\\w-]*$",
          "title": "Tape",
          "type": "string"
        },
        "then": {
          "description": "The handler that receives done()'s result as `result`.",
          "$ref": "#/$defs/HandlerRef"
        },
        "args": {
          "title": "Args",
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "type",
        "tape"
      ],
      "title": "Call",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "description": "A field reference: Record.field",
          "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
          "title": "Field",
          "type": "string"
        },
        "handler": {
          "title": "Handler",
          "type": "string"
        }
      },
      "required": [
        "field",
        "handler"
      ],
      "title": "Change",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "description": "A component: a field of a record the frame shows or edits, or a string the frame adds.\n\nDerived components nest: a record field's `components` are its fields, and a collection's\n`item` holds the components of each item. Only top-level derived components carry `from`.",
      "properties": {
        "field": {
          "title": "Field",
          "description": "A field reference: Record.field",
          "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Phrase"
            }
          ]
        },
        "from": {
          "title": "From",
          "enum": [
            "shows",
            "edit"
          ],
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "record": {
          "title": "Record",
          "type": "string"
        },
        "enum": {
          "title": "Enum",
          "type": "string"
        },
        "choices": {
          "title": "Choices",
          "items": {},
          "type": "array"
        },
        "lines": {
          "title": "Lines",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "item": {
          "$ref": "#/$defs/Item"
        },
        "nullable": {
          "title": "Nullable",
          "const": true,
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "enum": [
            "heading",
            "primary",
            "secondary",
            "navigation",
            "status",
            "supporting"
          ],
          "type": "string"
        },
        "importance": {
          "title": "Importance",
          "enum": [
            "required",
            "normal",
            "optional"
          ],
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "commit": {
          "title": "Commit",
          "enum": [
            "submit",
            "blur",
            "change"
          ],
          "type": "string"
        },
        "options": {
          "title": "Options"
        },
        "select": {
          "title": "Select",
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "back": "#/$defs/Back",
                  "call": "#/$defs/Call",
                  "copy": "#/$defs/Copy",
                  "done": "#/$defs/Done",
                  "download": "#/$defs/Download",
                  "goto": "#/$defs/Goto",
                  "jump": "#/$defs/Jump",
                  "open": "#/$defs/Open",
                  "stay": "#/$defs/Stay"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Jump"
                },
                {
                  "$ref": "#/$defs/Goto"
                },
                {
                  "$ref": "#/$defs/Back"
                },
                {
                  "$ref": "#/$defs/Stay"
                },
                {
                  "$ref": "#/$defs/Call"
                },
                {
                  "$ref": "#/$defs/Done"
                },
                {
                  "$ref": "#/$defs/Open"
                },
                {
                  "$ref": "#/$defs/Download"
                },
                {
                  "$ref": "#/$defs/Copy"
                }
              ]
            },
            {
              "$ref": "#/$defs/HandlerRef"
            }
          ]
        },
        "pages": {
          "$ref": "#/$defs/LoaderRef"
        },
        "anchor": {
          "title": "Anchor",
          "enum": [
            "start",
            "end"
          ],
          "type": "string"
        },
        "min_items": {
          "title": "Min Items",
          "type": "integer"
        },
        "max_items": {
          "title": "Max Items",
          "type": "integer"
        },
        "group_by": {
          "$ref": "#/$defs/FieldRef"
        },
        "surface": {
          "title": "Surface",
          "type": "boolean"
        },
        "visible": {
          "$ref": "#/$defs/FieldRef"
        },
        "hidden": {
          "$ref": "#/$defs/FieldRef"
        },
        "press": {
          "title": "Press",
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "back": "#/$defs/Back",
                  "call": "#/$defs/Call",
                  "copy": "#/$defs/Copy",
                  "done": "#/$defs/Done",
                  "download": "#/$defs/Download",
                  "goto": "#/$defs/Goto",
                  "jump": "#/$defs/Jump",
                  "open": "#/$defs/Open",
                  "stay": "#/$defs/Stay"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Jump"
                },
                {
                  "$ref": "#/$defs/Goto"
                },
                {
                  "$ref": "#/$defs/Back"
                },
                {
                  "$ref": "#/$defs/Stay"
                },
                {
                  "$ref": "#/$defs/Call"
                },
                {
                  "$ref": "#/$defs/Done"
                },
                {
                  "$ref": "#/$defs/Open"
                },
                {
                  "$ref": "#/$defs/Download"
                },
                {
                  "$ref": "#/$defs/Copy"
                }
              ]
            },
            {
              "$ref": "#/$defs/HandlerRef"
            }
          ]
        },
        "label": {
          "title": "Label",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Phrase"
            },
            {
              "$ref": "#/$defs/FieldRef"
            }
          ]
        },
        "pick": {
          "title": "Pick",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "gt": {
          "title": "Gt"
        },
        "ge": {
          "title": "Ge"
        },
        "lt": {
          "title": "Lt"
        },
        "le": {
          "title": "Le"
        },
        "affordances": {
          "items": {
            "enum": [
              "read",
              "write",
              "press",
              "choose",
              "adjust",
              "move",
              "add",
              "remove",
              "scroll",
              "play"
            ],
            "type": "string"
          },
          "title": "Affordances",
          "type": "array"
        },
        "many": {
          "description": "choose is choose(many): an edited list of choices.",
          "title": "Many",
          "const": true,
          "type": "boolean"
        },
        "components": {
          "title": "Components",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "type": "array"
        },
        "states": {
          "title": "States",
          "items": {
            "description": "A field reference: Record.field",
            "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "title": "Events",
          "additionalProperties": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "back": "#/$defs/Back",
                    "call": "#/$defs/Call",
                    "copy": "#/$defs/Copy",
                    "done": "#/$defs/Done",
                    "download": "#/$defs/Download",
                    "goto": "#/$defs/Goto",
                    "jump": "#/$defs/Jump",
                    "open": "#/$defs/Open",
                    "stay": "#/$defs/Stay"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Jump"
                  },
                  {
                    "$ref": "#/$defs/Goto"
                  },
                  {
                    "$ref": "#/$defs/Back"
                  },
                  {
                    "$ref": "#/$defs/Stay"
                  },
                  {
                    "$ref": "#/$defs/Call"
                  },
                  {
                    "$ref": "#/$defs/Done"
                  },
                  {
                    "$ref": "#/$defs/Open"
                  },
                  {
                    "$ref": "#/$defs/Download"
                  },
                  {
                    "$ref": "#/$defs/Copy"
                  }
                ]
              },
              {
                "$ref": "#/$defs/HandlerRef"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "change",
              "play",
              "progress",
              "ended",
              "error"
            ]
          },
          "type": "object"
        },
        "override": {
          "title": "Override",
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "affordances"
      ],
      "title": "Component",
      "type": "object"
    },
    "Copy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "copy",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "description": "A field reference: Record.field",
          "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Copy",
      "type": "object"
    },
    "Declared": {
      "additionalProperties": false,
      "description": "An outcome a handler returns, read from its body or its @vt.outcomes; `implied` marks the Stay\nevery handler has because it may Reject.",
      "properties": {
        "type": {
          "enum": [
            "goto",
            "jump",
            "back",
            "stay",
            "call",
            "done",
            "open",
            "download"
          ],
          "title": "Type",
          "type": "string"
        },
        "tape": {
          "title": "Tape",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "frame": {
          "title": "Frame",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "args": {
          "description": "The names of its keyword arguments.",
          "title": "Args",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "args_open": {
          "description": "It passes **kwargs, so not every name is known.",
          "title": "Args Open",
          "const": true,
          "type": "boolean"
        },
        "resets_history": {
          "description": "It signs in or out: history starts again.",
          "title": "Resets History",
          "const": true,
          "type": "boolean"
        },
        "then": {
          "$ref": "#/$defs/HandlerRef"
        },
        "implied": {
          "title": "Implied",
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "Declared",
      "type": "object"
    },
    "Destination": {
      "additionalProperties": false,
      "properties": {
        "tape": {
          "pattern": "^[A-Za-z][\\w-]*$",
          "title": "Tape",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Phrase"
            },
            {
              "$ref": "#/$defs/FieldRef"
            }
          ],
          "title": "Label"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "tape",
        "label"
      ],
      "title": "Destination",
      "type": "object"
    },
    "Done": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "done",
          "title": "Type",
          "type": "string"
        },
        "result": {
          "title": "Result"
        }
      },
      "required": [
        "type"
      ],
      "title": "Done",
      "type": "object"
    },
    "Download": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "download",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "data": {
          "title": "Data",
          "type": "string"
        },
        "encoding": {
          "title": "Encoding",
          "const": "base64",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "data"
      ],
      "title": "Download",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A declared edge of the journey graph. `to` is absent for back and done, and for names that do not\nexist. The platform's back (from every frame with history that is not a root and has no\nback=False) and the hub's doors are implied, not listed.",
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "type": {
          "enum": [
            "goto",
            "jump",
            "back",
            "call",
            "done"
          ],
          "title": "Type",
          "type": "string"
        },
        "tape": {
          "title": "Tape",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "frame": {
          "title": "Frame",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "resets_history": {
          "title": "Resets History",
          "const": true,
          "type": "boolean"
        },
        "via": {
          "additionalProperties": true,
          "title": "Via",
          "type": "object"
        }
      },
      "required": [
        "from",
        "type",
        "via"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Edits": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "title": "Record",
          "type": "string"
        }
      },
      "required": [
        "record"
      ],
      "title": "Edits",
      "type": "object"
    },
    "FieldRef": {
      "additionalProperties": false,
      "description": "A field reference, `Deal.amount`; in an action's arguments it means this item's value.",
      "properties": {
        "field": {
          "description": "A field reference: Record.field",
          "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "FieldRef",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "A place: its tape, and its `id` in a tape of several. Graph nodes are `tape` or `tape/id`.",
      "properties": {
        "id": {
          "title": "Id",
          "pattern": "^[A-Za-z][\\w-]*$",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Phrase"
            },
            {
              "$ref": "#/$defs/FieldRef"
            }
          ]
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "public": {
          "title": "Public",
          "const": true,
          "type": "boolean"
        },
        "shows": {
          "description": "The records the frame shows, which the user reads.",
          "title": "Shows",
          "items": {
            "$ref": "#/$defs/Shows"
          },
          "type": "array"
        },
        "edit": {
          "$ref": "#/$defs/Edits"
        },
        "enter": {
          "$ref": "#/$defs/LoaderRef"
        },
        "submit": {
          "$ref": "#/$defs/Submit"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "states": {
          "title": "States",
          "items": {
            "description": "A field reference: Record.field",
            "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$",
            "type": "string"
          },
          "type": "array"
        },
        "actions": {
          "title": "Actions",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "on_change": {
          "title": "On Change",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "after": {
          "$ref": "#/$defs/After"
        },
        "back": {
          "description": "back=False: no platform back here.",
          "title": "Back",
          "const": false,
