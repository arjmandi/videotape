{
  "format": "videotape.intent/2",
  "app": "screening",
  "entry": "home",
  "world": "screening-room",
  "hub": [
    {
      "tape": "home",
      "label": "Home",
      "symbol": "house"
    },
    {
      "tape": "search",
      "label": "Search",
      "symbol": "magnifier"
    },
    {
      "tape": "subscriptions",
      "label": "Subscriptions",
      "symbol": "list"
    }
  ],
  "tapes": [
    {
      "id": "home",
      "frames": [
        {
          "purpose": "See what is new",
          "address": "/",
          "public": true,
          "shows": [
            {
              "record": "Home"
            }
          ],
          "enter": {
            "loader": "load_home"
          },
          "components": [
            {
              "field": "Home.shelves",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Shelf",
                "components": [
                  {
                    "field": "Shelf.title",
                    "type": "string",
                    "role": "heading",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Shelf.videos",
                    "type": "collection",
                    "item": {
                      "type": "record",
                      "record": "VideoCard",
                      "components": [
                        {
                          "field": "VideoCard.thumbnail",
                          "type": "image",
                          "role": "primary",
                          "affordances": [
                            "read"
                          ]
                        },
                        {
                          "field": "VideoCard.title",
                          "type": "string",
                          "role": "heading",
                          "affordances": [
                            "read"
                          ]
                        },
                        {
                          "field": "VideoCard.channel",
                          "type": "string",
                          "role": "supporting",
                          "affordances": [
                            "read"
                          ]
                        }
                      ]
                    },
                    "select": {
                      "type": "jump",
                      "tape": "watch",
                      "args": {
                        "video_id": {
                          "field": "VideoCard.id"
                        }
                      }
                    },
                    "affordances": [
                      "read",
                      "press",
                      "scroll"
                    ]
                  }
                ]
              },
              "affordances": [
                "read",
                "scroll"
              ]
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "search",
      "frames": [
        {
          "purpose": "Find a video",
          "shows": [
            {
              "record": "Found"
            }
          ],
          "edit": {
            "record": "VideoSearch"
          },
          "components": [
            {
              "field": "Found.videos",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "VideoCard",
                "components": [
                  {
                    "field": "VideoCard.thumbnail",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.title",
                    "type": "string",
                    "role": "heading",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.channel",
                    "type": "string",
                    "role": "supporting",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "select": {
                "type": "jump",
                "tape": "watch",
                "args": {
                  "video_id": {
                    "field": "VideoCard.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            },
            {
              "field": "VideoSearch.q",
              "from": "edit",
              "type": "string",
              "kind": "search",
              "commit": "change",
              "label": "Search videos",
              "affordances": [
                "write"
              ]
            }
          ],
          "on_change": [
            {
              "field": "VideoSearch.q",
              "handler": "search_videos"
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "subscriptions",
      "frames": [
        {
          "purpose": "Follow the channels I subscribe to",
          "shows": [
            {
              "record": "Subscriptions"
            }
          ],
          "enter": {
            "loader": "load_subscriptions"
          },
          "components": [
            {
              "field": "Subscriptions.channels",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Channel",
                "components": [
                  {
                    "field": "Channel.name",
                    "type": "string",
                    "affordances": [
                      "read"
                    ]
                  }
                ],
                "states": [
                  "Channel.subscribed"
                ]
              },
              "select": {
                "type": "jump",
                "tape": "channel",
                "args": {
                  "channel_id": {
                    "field": "Channel.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "watch",
      "frames": [
        {
          "purpose": "Watch a video and decide what next",
          "address": "/watch/{video_id}",
          "public": true,
          "shows": [
            {
              "record": "Watch"
            }
          ],
          "enter": {
            "loader": "load_watch"
          },
          "components": [
            {
              "field": "Watch.player",
              "from": "shows",
              "type": "video",
              "role": "primary",
              "importance": "required",
              "affordances": [
                "play"
              ],
              "events": {
                "ended": {
                  "handler": "play_next"
                }
              },
              "override": true
            },
            {
              "field": "Watch.title",
              "from": "shows",
              "type": "string",
              "role": "heading",
              "affordances": [
                "read"
              ]
            },
            {
              "field": "Watch.channel",
              "from": "shows",
              "type": "record",
              "record": "Channel",
              "affordances": [],
              "components": [
                {
                  "field": "Channel.name",
                  "type": "string",
                  "affordances": [
                    "read",
                    "press"
                  ],
                  "role": "navigation",
                  "press": {
                    "type": "jump",
                    "tape": "channel",
                    "args": {
                      "channel_id": {
                        "field": "Channel.id"
                      }
                    }
                  },
                  "override": true
                }
              ],
              "states": [
                "Channel.subscribed"
              ]
            },
            {
              "field": "Watch.description",
              "from": "shows",
              "type": "richtext",
              "importance": "optional",
              "affordances": [
                "read"
              ]
            },
            {
              "field": "Watch.up_next",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "VideoCard",
                "components": [
                  {
                    "field": "VideoCard.thumbnail",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.title",
                    "type": "string",
                    "role": "heading",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.channel",
                    "type": "string",
                    "role": "supporting",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "select": {
                "type": "jump",
                "tape": "watch",
                "args": {
                  "video_id": {
                    "field": "VideoCard.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            },
            {
              "field": "Watch.comments",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Comment",
                "components": [
                  {
                    "field": "Comment.author",
                    "type": "string",
                    "role": "supporting",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Comment.text",
                    "type": "richtext",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "importance": "optional",
              "pages": {
                "loader": "comments_page"
              },
              "affordances": [
                "read",
                "scroll"
              ]
            }
          ],
          "actions": [
            {
              "label": "Subscribe",
              "target": {
                "handler": "subscribe"
              },
              "affordance": "press",
              "hidden": {
                "field": "Channel.subscribed"
              }
            },
            {
              "label": "Subscribed",
              "target": {
                "handler": "unsubscribe"
              },
              "affordance": "press",
              "visible": {
                "field": "Channel.subscribed"
              }
            }
          ],
          "under": "home"
        }
      ]
    },
    {
      "id": "channel",
      "frames": [
        {
          "purpose": "Visit a channel",
          "address": "/channel/{channel_id}",
          "public": true,
          "shows": [
            {
              "record": "ChannelPage"
            }
          ],
          "enter": {
            "loader": "load_channel"
          },
          "components": [
            {
              "field": "ChannelPage.name",
              "from": "shows",
              "type": "string",
              "role": "heading",
              "affordances": [
                "read"
              ]
            },
            {
              "field": "ChannelPage.videos",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "VideoCard",
                "components": [
                  {
                    "field": "VideoCard.thumbnail",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.title",
                    "type": "string",
                    "role": "heading",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "VideoCard.channel",
                    "type": "string",
                    "role": "supporting",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "select": {
                "type": "jump",
                "tape": "watch",
                "args": {
                  "video_id": {
                    "field": "VideoCard.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            }
          ],
          "under": "home"
        }
      ]
    }
  ],
