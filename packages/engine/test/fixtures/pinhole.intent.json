                "read"
              ]
            },
            {
              "field": "Profile.avatar",
              "from": "shows",
              "type": "image",
              "affordances": [
                "read"
              ]
            },
            {
              "field": "Profile.posts",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Post",
                "components": [
                  {
                    "field": "Post.author",
                    "type": "record",
                    "record": "Author",
