                      "type": "jump",
                      "tape": "profile",
                      "args": {
                        "user_id": {
                          "field": "Author.id"
                        }
                      }
                    },
                    "affordances": [
                      "press"
                    ],
                    "components": [
                      {
                        "field": "Author.name",
                        "type": "string",
                        "affordances": [
                          "read"
                        ]
                      },
                      {
                        "field": "Author.avatar",
                        "type": "image",
                        "affordances": [
                          "read"
                        ]
                      }
                    ]
                  },
                  {
                    "field": "Post.photo",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.likes",
                    "type": "integer",
                    "format": "count",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.caption",
                    "type": "richtext",
                    "affordances": [
                      "read"
                    ]
                  }
                ],
                "states": [
                  "Post.liked"
                ]
              },
              "select": {
                "type": "jump",
                "tape": "post",
                "args": {
                  "post_id": {
                    "field": "Post.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            }
          ],
          "under": "feed"
        }
      ]
    },
    {
      "id": "stories",
      "frames": [
        {
          "purpose": "Watch one story",
          "shows": [
            {
              "record": "Story"
            }
          ],
          "enter": {
            "loader": "load_story"
          },
          "components": [
            {
              "field": "Story.picture",
              "from": "shows",
              "type": "image",
              "role": "primary",
              "affordances": [
                "read"
              ]
            },
            {
              "field": "Story.who",
              "from": "shows",
              "type": "string",
              "role": "supporting",
              "affordances": [
                "read"
              ]
            }
          ],
          "actions": [
            {
              "label": "Next",
              "target": {
                "handler": "next_story"
              },
              "affordance": "press",
              "gesture": "tap-trailing"
            },
            {
              "label": "Previous",
              "target": {
                "handler": "previous_story"
              },
              "affordance": "press",
              "gesture": "tap-leading"
            }
          ],
          "after": {
            "seconds": 5,
            "then": {
              "handler": "next_story"
            }
          },
          "hub": false
        }
      ]
    },
    {
      "id": "post",
      "frames": [
        {
          "purpose": "Read one post and what people said",
          "address": "/p/{post_id}",
          "public": true,
