              "affordances": [],
              "components": [
                {
                  "field": "Post.author",
                  "type": "record",
                  "record": "Author",
                  "press": {
                    "type": "jump",
                    "tape": "profile",
                    "args": {
                      "user_id": {
                        "field": "Author.id"
                      }
                    }
                  },
                  "affordances": [
                    "press"
                  ],
                  "components": [
                    {
                      "field": "Author.name",
                      "type": "string",
                      "affordances": [
                        "read"
                      ]
                    },
                    {
                      "field": "Author.avatar",
                      "type": "image",
                      "affordances": [
                        "read"
                      ]
                    }
