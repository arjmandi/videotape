            {
              "field": "PostPage.comments",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Comment",
                "components": [
                  {
                    "field": "Comment.author",
                    "type": "record",
                    "record": "Author",
                    "affordances": [],
