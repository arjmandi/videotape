{
  "format": "videotape.intent/2",
  "app": "pinhole",
  "entry": "feed",
  "world": "darkroom",
  "hub": [
    {
      "tape": "feed",
      "label": "Feed",
      "symbol": "house"
    },
    {
      "tape": "explore",
      "label": "Explore",
      "symbol": "magnifier"
    },
    {
      "tape": "activity",
      "label": "Activity",
      "symbol": "heart"
    }
  ],
  "tapes": [
    {
      "id": "feed",
      "frames": [
        {
          "purpose": "See what people I follow posted",
          "shows": [
            {
              "record": "Feed"
            }
          ],
          "enter": {
            "loader": "load_feed"
          },
          "components": [
            {
              "field": "Feed.posts",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Post",
                "components": [
                  {
                    "field": "Post.author",
                    "type": "record",
                    "record": "Author",
                    "press": {
                      "type": "jump",
                      "tape": "profile",
                      "args": {
                        "user_id": {
                          "field": "Author.id"
                        }
                      }
                    },
                    "affordances": [
                      "press"
                    ],
                    "components": [
                      {
                        "field": "Author.name",
                        "type": "string",
                        "affordances": [
                          "read"
                        ]
                      },
                      {
                        "field": "Author.avatar",
                        "type": "image",
                        "affordances": [
                          "read"
                        ]
                      }
                    ]
                  },
                  {
                    "field": "Post.photo",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.likes",
                    "type": "integer",
                    "format": "count",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.caption",
                    "type": "richtext",
                    "affordances": [
                      "read"
                    ]
                  }
                ],
                "states": [
                  "Post.liked"
                ]
              },
              "pages": {
                "loader": "feed_page"
              },
              "affordances": [
                "read",
                "scroll"
              ]
            }
          ],
          "actions": [
            {
              "label": "Like",
              "target": {
                "handler": "like"
              },
              "affordance": "press",
              "on": "Post",
              "gesture": "double-tap",
              "hidden": {
                "field": "Post.liked"
              }
            },
            {
              "label": "Liked",
              "target": {
                "handler": "unlike"
              },
              "affordance": "press",
              "on": "Post",
              "visible": {
                "field": "Post.liked"
              }
            },
            {
              "label": "Comments",
              "target": {
                "type": "jump",
                "tape": "post",
                "args": {
                  "post_id": {
                    "field": "Post.id"
                  }
                }
              },
              "affordance": "press",
              "on": "Post"
            },
            {
              "label": "Stories",
              "target": {
                "type": "jump",
                "tape": "stories"
              },
              "affordance": "press"
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "explore",
      "frames": [
        {
          "purpose": "Discover posts",
          "shows": [
            {
              "record": "Explore"
            }
          ],
          "enter": {
            "loader": "load_explore"
          },
          "components": [
            {
              "field": "Explore.posts",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Post",
                "components": [
                  {
                    "field": "Post.author",
                    "type": "record",
                    "record": "Author",
                    "press": {
                      "type": "jump",
                      "tape": "profile",
                      "args": {
                        "user_id": {
                          "field": "Author.id"
                        }
                      }
                    },
                    "affordances": [
                      "press"
                    ],
                    "components": [
                      {
                        "field": "Author.name",
                        "type": "string",
                        "affordances": [
                          "read"
                        ]
                      },
                      {
                        "field": "Author.avatar",
                        "type": "image",
                        "affordances": [
                          "read"
                        ]
                      }
                    ]
                  },
                  {
                    "field": "Post.photo",
                    "type": "image",
                    "role": "primary",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.likes",
                    "type": "integer",
                    "format": "count",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Post.caption",
                    "type": "richtext",
                    "affordances": [
                      "read"
                    ]
                  }
                ],
                "states": [
                  "Post.liked"
                ]
              },
              "select": {
                "type": "jump",
                "tape": "post",
                "args": {
                  "post_id": {
                    "field": "Post.id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "activity",
      "frames": [
        {
          "purpose": "See who reacted",
          "shows": [
            {
              "record": "Activity"
            }
          ],
          "enter": {
            "loader": "load_activity"
          },
          "components": [
            {
              "field": "Activity.reactions",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Reaction",
                "components": [
                  {
                    "field": "Reaction.who",
                    "type": "string",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Reaction.what",
                    "type": "string",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "select": {
                "type": "jump",
                "tape": "post",
                "args": {
                  "post_id": {
                    "field": "Reaction.post_id"
                  }
                }
              },
              "affordances": [
                "read",
                "press",
                "scroll"
              ]
            }
          ],
          "root": "always"
        }
      ]
    },
    {
      "id": "profile",
      "frames": [
        {
          "purpose": "Look at someone",
          "address": "/u/{user_id}",
          "public": true,
