{
  "format": "videotape.intent/2",
  "app": "pipeline",
  "entry": "deals",
  "world": "quiet-office",
  "hub": [
    {
      "tape": "deals",
      "label": "Deals",
      "symbol": "board"
    },
    {
      "tape": "contacts",
      "label": "Contacts",
      "symbol": "person"
    }
  ],
  "tapes": [
    {
      "id": "deals",
      "frames": [
        {
          "purpose": "See every open deal by stage and move them on",
          "shows": [
            {
              "record": "Pipeline"
            }
          ],
          "enter": {
            "loader": "load_pipeline"
          },
          "components": [
            {
              "field": "Pipeline.deals",
              "from": "shows",
              "type": "collection",
              "item": {
                "type": "record",
                "record": "Deal",
                "components": [
                  {
                    "field": "Deal.name",
                    "type": "string",
                    "role": "heading",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Deal.company",
                    "type": "record",
                    "record": "Company",
                    "pick": "pick_company",
                    "affordances": [],
                    "components": [
                      {
                        "field": "Company.name",
                        "type": "string",
                        "role": "heading",
                        "affordances": [
                          "read"
                        ]
                      }
                    ]
                  },
                  {
                    "field": "Deal.amount",
                    "type": "money",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Deal.stage",
                    "type": "choice",
                    "enum": "Stage",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Deal.close",
                    "type": "date",
                    "nullable": true,
                    "group": "dates",
                    "affordances": [
                      "read"
                    ]
                  },
                  {
                    "field": "Deal.owner",
                    "type": "record",
                    "record": "User",
                    "group": "people",
                    "options": {
                      "loader": "team"
                    },
                    "affordances": [],
                    "components": [
                      {
                        "field": "User.name",
                        "type": "string",
                        "affordances": [
                          "read"
                        ]
                      }
                    ]
                  },
                  {
                    "field": "Deal.notes",
                    "type": "text",
                    "lines": [
                      3,
                      12
                    ],
                    "nullable": true,
                    "importance": "optional",
                    "affordances": [
                      "read"
                    ]
                  }
                ]
              },
              "select": {
                "type": "jump",
                "tape": "deal",
                "args": {
                  "deal_id": {
                    "field": "Deal.id"
                  }
                }
              },
              "group_by": {
                "field": "Deal.stage"
              },
              "affordances": [
                "read",
                "press",
                "move",
                "scroll"
              ]
            },
            {
              "field": "Pipeline.forecast",
              "from": "shows",
              "type": "series",
              "importance": "optional",
              "affordances": [
                "read"
              ]
            }
          ],
          "states": [
            "Pipeline.can_export"
          ],
          "actions": [
            {
              "label": "Move to stage",
              "target": {
                "handler": "move_deal"
              },
              "affordance": "move",
              "on": "Deal",
              "to": "Stage",
              "gesture": "drag"
            },
            {
              "label": "New deal",
              "target": {
                "type": "jump",
                "tape": "new_deal"
              },
              "affordance": "press",
              "key": "n",
              "role": "primary"
            },
            {
              "label": "Export CSV",
              "target": {
                "handler": "export_csv"
              },
              "affordance": "press",
              "importance": "optional",
              "visible": {
                "field": "Pipeline.can_export"
              }
            }
          ],
          "root": "sometimes"
        }
      ]
    },
