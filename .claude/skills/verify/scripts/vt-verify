#!/usr/bin/env bash
# Drives the videotape CLI and the TapePlayer app's scripts, and records each run as evidence.
set -uo pipefail
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$ROOT" || exit 2

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

usage() {
  echo "usage: vt-verify launch [qwen|wan] | doctor | run <run-dir> <name> <project-dir> -- <videotape args...> | exec <run-dir> <name> [-C <dir>] -- <command...> | screenshot <run-dir> <name> <html-file> [height] | player-build <run-dir> | player-press <run-dir> <tape-dir> [<label>...] | player-test <run-dir> | player-cuts <run-dir> [cuts]" >&2
  exit 2
}

# capture <run-dir> <name> <working-dir> <command...> runs the command in the working directory and records it.
capture() {
  local dir="$1" name="$2" where="$3" code; shift 3
  { [ "$where" != . ] && printf 'cd %q && ' "$where"; printf '%q' "$1"; [ $# -gt 1 ] && printf ' %q' "${@:2}"; echo; } > "$dir/$name.cmd"
  git rev-parse HEAD > "$dir/$name.build"
  (cd "$where" && "$@") > "$dir/$name.stdout" 2> "$dir/$name.stderr"
  code=$?
  echo "$code" > "$dir/$name.exit"
  echo "$name: exit $code, $(wc -l < "$dir/$name.stdout" | tr -d ' ') stdout lines, $(wc -l < "$dir/$name.stderr" | tr -d ' ') stderr lines -> $dir/$name.*"
  return $code
}

case "${1:-}" in
  launch)
    case "${2:-}" in
      "") uv sync && uv sync --project examples/contrail && uv run videotape --help >/dev/null && echo "ready: videotape CLI installed in $ROOT/.venv and $ROOT/examples/contrail/.venv" ;;
      qwen) uv sync --extra qwen && uv run videotape --help >/dev/null && echo "ready: videotape CLI installed in $ROOT/.venv with the qwen extra" ;;
      wan) uv sync --extra wan --extra qwen && uv run videotape --help >/dev/null && echo "ready: videotape CLI installed in $ROOT/.venv with the wan and qwen extras" ;;
      *) usage ;;
    esac
    ;;
  exec)
    [ $# -ge 4 ] || usage
    dir="$2"; name="$3"; where=.; shift 3
    [ "$1" = "-C" ] && { where="$2"; shift 2; }
    [ "${1:-}" = "--" ] && [ $# -ge 2 ] || usage
    shift
    mkdir -p "$dir"; dir="$(cd "$dir" && pwd)"
    capture "$dir" "$name" "$where" "$@"
    ;;
  doctor)
    status=0
    command -v uv >/dev/null || { echo "FAIL uv not on PATH"; status=1; }
    if command -v ffmpeg >/dev/null; then
      echo "ok   ffmpeg $(ffmpeg -hide_banner -version | head -1 | cut -d' ' -f3) at $(command -v ffmpeg)"
    else
      echo "FAIL ffmpeg not on PATH; render needs it (brew install ffmpeg)"; status=1
    fi
    [ -x "$CHROME" ] && echo "info chrome found; screenshot works" || echo "info chrome not found; screenshot cannot run"
    if xcode=$(xcodebuild -version 2>/dev/null); then
      echo "info ${xcode%%$'\n'*} at $(xcode-select -p); player-build, player-test and player-cuts work"
    else
      echo "info xcode not found; player-build, player-test and player-cuts cannot run"
    fi
    [ -x .venv/bin/videotape ] || { echo "FAIL .venv/bin/videotape missing; run: vt-verify launch"; status=1; }
    # Call .venv directly: `uv run` would create or sync the venv, and doctor must not change anything.
    where="no .venv/bin/python"
    [ -x .venv/bin/python ] && where=$(.venv/bin/python -c 'import sys, videotape; print(sys.version.split()[0], videotape.__file__)' 2>&1)
    case "$where" in
      3.12.*" $ROOT/videotape/__init__.py") echo "ok   python $where" ;;
      *) echo "FAIL expected Python 3.12 importing $ROOT/videotape, got: $where"; status=1 ;;
    esac
    [ -x .venv/bin/videotape ] && .venv/bin/videotape --help >/dev/null 2>&1 && echo "ok   videotape --help exits 0" || { echo "FAIL videotape --help"; status=1; }
    [ -x examples/contrail/.venv/bin/videotape ] && echo "ok   examples/contrail/.venv/bin/videotape, so uv run works in the example" || echo "info examples/contrail has no .venv yet; run: vt-verify launch"
    # Reports where qwen3-vl-8b checks would run without loading the model or downloading its weights.
    qwen=$(.venv/bin/python - 2>/dev/null <<'PY'
import torch, transformers
from huggingface_hub import try_to_load_from_cache
device = "cuda" if torch.cuda.is_available() else "mps" if torch.backends.mps.is_available() else "none"
cached = isinstance(try_to_load_from_cache("Qwen/Qwen3-VL-8B-Instruct", "config.json"), str)
print(device, "cached" if cached else "not downloaded yet", transformers.__version__, torch.__version__, sep="|")
PY
)
    IFS='|' read -r device weights transformers torch <<< "$qwen"
    case "$device" in
      "") echo "info qwen extra not installed; run vt-verify launch qwen before rendering with a model other than the stand-in" ;;
      none) echo "info qwen extra installed (transformers $transformers, torch $torch); qwen3-vl-8b checks cannot run without CUDA or MPS" ;;
      *) echo "info qwen extra installed (transformers $transformers, torch $torch); qwen3-vl-8b checks run on $device; weights $weights" ;;
    esac
    echo "info build $(git rev-parse --short HEAD)$( [ -n "$(git status --porcelain -- videotape pyproject.toml examples scripts clients/macos)" ] && echo ' + uncommitted changes in videotape/, pyproject.toml, examples/, scripts/ or clients/macos/')"
    exit $status
    ;;
  run)
    [ $# -ge 5 ] && [ "$5" = "--" ] || usage
    dir="$2"; name="$3"; project="$4"; shift 5
    [ -d "$project" ] || { echo "FAIL no project directory $project" >&2; exit 2; }
    mkdir -p "$dir"; dir="$(cd "$dir" && pwd)"; rm -f "$dir/$name.light.png" "$dir/$name.dark.png"
    { printf 'cd %q && videotape' "$project"; printf ' %q' "$@"; echo; } > "$dir/$name.cmd"
    git rev-parse HEAD > "$dir/$name.build"
    (cd "$project" && PYTHONDONTWRITEBYTECODE=1 "$ROOT/.venv/bin/videotape" "$@") > "$dir/$name.stdout" 2> "$dir/$name.stderr"
    code=$?
    echo "$code" > "$dir/$name.exit"
    # A project outside the checkout is a scratch one, so its files are kept with the evidence.
    case "$(cd "$project" && pwd -P)/" in
      "$(pwd -P)"/*) ;;
      *) rm -rf "$dir/$name.project"; mkdir "$dir/$name.project"
         find "$project" -maxdepth 2 -type f \( -name '*.py' -o -name '*.json' -o -name '*.toml' \) -not -path '*/tape*/*' -not -path '*/.venv/*' -exec cp {} "$dir/$name.project/" \; ;;
    esac
    echo "$name: exit $code, $(wc -l < "$dir/$name.stdout" | tr -d ' ') stdout lines, $(wc -l < "$dir/$name.stderr" | tr -d ' ') stderr lines -> $dir/$name.*"
    ;;
  screenshot)
    [ $# -eq 4 ] || [ $# -eq 5 ] || usage
    dir="$2"; name="$3"; page="$(cd "$(dirname "$4")" && pwd)/$(basename "$4")"; height="${5:-2400}"
    [ -x "$CHROME" ] || { echo "FAIL chrome not found at $CHROME" >&2; exit 1; }
    mkdir -p "$dir"; rm -f "$dir/$name.light.png" "$dir/$name.dark.png"
    profile="$(mktemp -d)"
    # --virtual-time-budget lets the looping videos decode a frame before the capture.
    for scheme in light dark; do
      flags=(); [ "$scheme" = dark ] && flags=(--force-dark-mode --blink-settings=preferredColorScheme=0)
      "$CHROME" --headless=new --disable-gpu --hide-scrollbars --autoplay-policy=no-user-gesture-required \
        --window-size=1280,"$height" --virtual-time-budget=4000 --user-data-dir="$profile/$scheme" ${flags[@]+"${flags[@]}"} \
        --screenshot="$dir/$name.$scheme.png" "file://$page" >/dev/null 2>&1
    done
    rm -rf "$profile"
    ls "$dir/$name.light.png" "$dir/$name.dark.png" >/dev/null && echo "$name: screenshots -> $dir/$name.light.png $dir/$name.dark.png"
    ;;
  player-build)
    [ $# -eq 2 ] || usage
    mkdir -p "$2"
    capture "$2" player-build . clients/macos/build.sh
    ;;
  player-press)
    [ $# -ge 3 ] || usage
    mkdir -p "$2"; dir="$2"; tape="$(cd "$3" && pwd)" || exit 2; shift 3
    press=.claude/skills/verify/scripts/player-press
    swift build --quiet --package-path "$press" --scratch-path clients/macos/build/player-press || exit 2
    capture "$dir" player-press . "$(swift build --package-path "$press" --scratch-path clients/macos/build/player-press --show-bin-path)/player-press" "$tape" "$@"
    ;;
  player-test)
    [ $# -eq 2 ] || usage
    mkdir -p "$2"; dir="$(cd "$2" && pwd)"
    rm -rf "$dir/player-test.xcresult" "$dir/player-test.attachments"
    capture "$dir" player-test . clients/macos/test.sh -resultBundlePath "$dir/player-test.xcresult"
    code=$?
    [ -d "$dir/player-test.xcresult" ] && xcrun xcresulttool export attachments --path "$dir/player-test.xcresult" \
      --output-path "$dir/player-test.attachments" >/dev/null && echo "player-test: attachments -> $dir/player-test.attachments"
    exit $code
    ;;
  player-cuts)
    [ $# -ge 2 ] && [ $# -le 3 ] || usage
    mkdir -p "$2"
    capture "$2" player-cuts . .claude/skills/verify/scripts/player-cuts/run ${3:+"$3"}
    ;;
  *) usage ;;
esac
