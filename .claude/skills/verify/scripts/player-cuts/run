#!/usr/bin/env bash
# Builds the cut harness against TapePlayer's TapeView and Projector, and against the control projector, then plays
# examples/contrail/tape through each. Passes when TapePlayer shows no flash and the control does, which proves the
# captures can see one.
# usage: run [cuts]
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(git -C "$here" rev-parse --show-toplevel)"
mac="$root/clients/macos"
out="$mac/build/player-cuts"
cuts="${1:-30}"
# macOS 14 keeps CGWindowListCreateImage, which macOS 15 removed from the SDK.
flags=(-swift-version 6 -target "$(uname -m)-apple-macos14.0" -O -suppress-warnings)

mkdir -p "$out"
swiftc "${flags[@]}" -parse-as-library -emit-library -static -emit-module -module-name TapeKit \
  "$mac"/TapeKit/Sources/TapeKit/*.swift -o "$out/libTapeKit.a" -emit-module-path "$out/TapeKit.swiftmodule" || exit 2
for projector in tapeplayer control; do
  source="$mac/TapePlayer/Projector.swift"
  [ "$projector" = control ] && source="$here/control/Projector.swift"
  swiftc "${flags[@]}" -I "$out" -L "$out" -lTapeKit "$mac/TapePlayer/TapeView.swift" "$source" "$here/main.swift" \
    -o "$out/$projector" || exit 2
done

echo "== TapePlayer's projector"
"$out/tapeplayer" "$root/examples/contrail/tape" "$cuts"
tapeplayer=$?
echo "== control: one player layer and replaceCurrentItem"
"$out/control" "$root/examples/contrail/tape" "$cuts"
control=$?

if [ $tapeplayer -eq 0 ] && [ $control -eq 1 ]; then
  echo "ok: no flash in $cuts cuts, and the control flashed"
  exit 0
fi
[ $tapeplayer -ne 0 ] && echo "FAIL TapePlayer's projector exited $tapeplayer"
[ $control -ne 1 ] && echo "FAIL the control exited $control instead of flashing, so the captures prove nothing"
exit 1
