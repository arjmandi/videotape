# The marks persist in the browser while a person works through the takes, and the button saves them as marks.json.
SCRIPT = """
const boxes = [...document.querySelectorAll("input.mark")];
let kept = {};
try { kept = JSON.parse(localStorage.getItem("screen-test-marks") || "{}"); } catch {}
for (const box of boxes) {
  const id = `${box.dataset.clip}#${box.dataset.place}`;
  if (id in kept) box.checked = kept[id];
  box.addEventListener("change", () => {
    kept[id] = box.checked;
    try { localStorage.setItem("screen-test-marks", JSON.stringify(kept)); } catch {}
  });
}
const calibration = document.getElementById("calibration");
document.getElementById("download")?.addEventListener("click", () => {
  const marks = boxes.map(box => ({state: box.dataset.state, seed: Number(box.dataset.seed), clip: box.dataset.clip,
    element: Number(box.dataset.place), type: box.dataset.type, right: box.checked}));
  const held = {model: calibration.dataset.model, story: calibration.dataset.story, marks};
  const link = document.createElement("a");
  link.href = URL.createObjectURL(new Blob([JSON.stringify(held, null, 2) + "\\n"], {type: "application/json"}));
  link.download = "marks.json";
  link.click();
  setTimeout(() => URL.revokeObjectURL(link.href), 1000);
});
"""


def _money(usd: float) -> str:
    return f"${usd:.2f}"


def _bar_rule(screen: Screen) -> str:
    return (f"An element type meets its bar on a model when, in each story, at least {BAR:.0%} of its elements across "
            f"the model's {len(screen.keys) * TAKES} takes pass every check that judges them.")


def _pick(screen: Screen) -> str:
    chosen, agreed = screen.pick, screen.agreement
    lines = []
    if agreed is None:
        model, told = CALIBRATION
        lines.append(f"<p>The checks are not yet held to a person's marks: mark {model}'s {told} takes under "
                     "Calibration, download marks.json, and run the screen test again with --marks marks.json.</p>")
    elif not agreed.held:
        lines.append(f'<p class="pick withheld">{escape(_upper_first(agreed.said()))}, below {AGREEMENT:.0%}: fix the '
                     "checks before the pick. The pick is withheld.</p>")
    if chosen is not None:
        others = []
        for other in screen.standings:
            if other is chosen:
                continue
            said = f"{other.model} brings {len(other.met)} to the bar"
            if len(other.met) == len(chosen.met) and other.passing.share < chosen.passing.share:
                said += f" too, and {other.passing} of its elements pass every check, {other.passing.share:.1%}"
            elif len(other.met) == len(chosen.met) and other.invented > chosen.invented:
                said += (f" too, and invents {_count(other.invented, 'control')} where {chosen.model} invents "
                         f"{chosen.invented}")
            elif len(other.met) == len(chosen.met):
                said += (f" too, invents as many controls, and cost {_money(other.usd)} where {chosen.model} cost "
                         f"{_money(chosen.usd)}")
            others.append(f"{said}.")
        lines.append(f'<p class="pick">The pick is {escape(chosen.model)}: {len(chosen.met)} of {len(screen.kinds)} '
                     f"element types at the bar in every story, {chosen.passing} of its elements pass every check, "
                     f"{chosen.passing.share:.1%}, {_count(chosen.invented, 'control')} invented.</p>"
                     f"<p>{escape(' '.join(others))}</p>")
        lines.append(f'<p>To render with it, set model = "{escape(chosen.model)}" in [tool.videotape] in the '
                     "project's pyproject.toml. The screen test leaves it as it is.</p>")
    missed = [kind for kind in screen.kinds if not any(kind in standing.met for standing in screen.standings)]
    if missed:
        lines.append("<ul>" + "".join(
            f"<li>{kind} misses the bar on every model; its best is {tally} on {escape(model)}, in {escape(told)}.</li>"
            for kind in missed for model, told, tally in [screen.best(kind)]) + "</ul>")
    lines.append(f"<p class=\"note\">{_bar_rule(screen)} The pick has the most element types at the bar, then the "
                 "largest share of elements that pass every check, then the fewest controls invented, then the lowest "
                 "cost.</p>")
    attribute = f' data-pick="{escape(chosen.model)}"' if chosen else ""
    return f'<section class="shot" id="pick"{attribute}>\n<h2>The pick</h2>\n{"".join(lines)}\n</section>'


def _elements(screen: Screen) -> str:
    head = "".join(f'<th colspan="{len(screen.stories)}">{escape(model)}</th>' for model in screen.models)
    stories = "".join(f"<th>{escape(told)}</th>" for _ in screen.models for told in screen.stories)
    rows = []
    for kind in screen.kinds:
        cells = []
        for model in screen.models:
            for told in screen.stories:
                tally = screen.tally(model, told, kind)
                by = "".join(f'<span class="by" data-code="{code}">{code} {count}</span>'
                             for code, count in screen.checks(model, told, kind).items() if count.of)
                cells.append(f'<td class="{"met" if tally.met else "missed"}" data-type="{kind}" '
                             f'data-model="{escape(model)}" data-story="{escape(told)}" data-tally="{tally}">'
                             f"{tally}, {tally.share:.0%}{by}</td>")
        rows.append(f'<tr data-type="{kind}"><th>{kind}</th>{"".join(cells)}</tr>')
    said = ", ".join(f"{code} {what}" for code, what in CODES.items())
    return f"""<section class="shot" id="elements">
<h2>Element types</h2>
<p class="note">Each cell: the elements of the type, across the model's takes in the story, that pass every check that
judges them, then how many of each check passed: {said}. {_bar_rule(screen)}</p>
<div class="scroll"><table>
<thead><tr><th rowspan="2">Element type</th>{head}</tr><tr>{stories}</tr></thead>
<tbody>{"".join(rows)}</tbody>
</table></div>
</section>"""


def _keys(screen: Screen) -> str:
    head = "".join(f'<th colspan="{len(screen.stories)}">{escape(model)}</th>' for model in screen.models)
    stories = "".join(f"<th>{escape(told)}</th>" for _ in screen.models for told in screen.stories)
    pairs = [(model, told) for model in screen.models for told in screen.stories]
    rows = []
    for key in screen.keys:
        cells = []
        for model, told in pairs:
            counts = ", ".join(str(take.invented) for take in screen.of(model, told) if take.state == key.state.name)
            cells.append(f'<td data-key="{escape(key.state.name)}" data-model="{escape(model)}" '
                         f'data-story="{escape(told)}" data-invented="{counts}">{counts}</td>')
        rows.append(f"<tr><th>{escape(key.state.name)}</th>{''.join(cells)}</tr>")
    yields = "".join(f'<td data-model="{escape(model)}" data-story="{escape(told)}" data-yield="{tally}">{tally}</td>'
                     for model, told in pairs for tally in [screen.first_takes(model, told)])
    seconds = "".join(f"<td>{sum(take.seconds or 0.0 for take in screen.of(model, told)):.1f} s</td>"
                      for model, told in pairs)
    usd = "".join(f"<td>{_money(sum(take.usd for take in screen.of(model, told)))}</td>" for model, told in pairs)
    return f"""<section class="shot" id="keys">
<h2>Controls invented and first takes</h2>
<p class="note">For each key, the controls each take invents (VT503, a check of the whole key), as each reader saw
them, take by take. Then the first takes that pass every check, and the time and the cost of every take.</p>
<div class="scroll"><table>
<thead><tr><th rowspan="2">Key</th>{head}</tr><tr>{stories}</tr></thead>
<tbody>{"".join(rows)}
<tr><th>First-take yield</th>{yields}</tr>
<tr><th>Time</th>{seconds}</tr>
<tr><th>Cost</th>{usd}</tr></tbody>
</table></div>
</section>"""


def _take(take: Take) -> str:
    if take.refused:
        return (f'<figure class="take refused" data-model="{escape(take.model)}" data-story="{escape(take.story)}" '
                f'data-key="{escape(take.state)}" data-seed="{take.seed}" data-usd="{take.usd:.2f}">'
                f'<p class="note fail">The model refused this take for its content, VT409, so nothing was filmed and '
                f'every element of it counts as not drawn right.</p><figcaption><strong>Take {take.seed}</strong>'
                f'<span class="badge failing">refused VT409</span><span class="badge">{_money(take.usd)}</span>'
                "</figcaption></figure>")
    # A failing check stays in view, so the models compare at a glance, and the passing ones fold away.
    failing = [item for item in take.items if not item["passed"]]
    passing = [item for item in take.items if item["passed"]]
    verdict = "fails " + " ".join(sorted({item["code"] for item in failing})) if failing else "passed"
    seconds = f"{take.seconds:.1f} s" if take.seconds is not None else "time unknown"
    timed = f' data-seconds="{take.seconds:.1f}"' if take.seconds is not None else ""
    passed = (f"<details><summary>{_count(len(passing), 'check')} passed</summary><ul class=\"checks\">"
              f"{dailies.checklist(passing)}</ul></details>" if passing else "")
    return (f'<figure class="take" data-model="{escape(take.model)}" data-story="{escape(take.story)}" '
            f'data-key="{escape(take.state)}" data-seed="{take.seed}" data-usd="{take.usd:.2f}"{timed}>'
            f'<img src="{escape(take.tape)}/{escape(take.picture)}" alt="The last frame of take {take.seed} of '
            f'{escape(take.state)} on {escape(take.model)} in {escape(take.story)}" loading="lazy">'
            f'<figcaption><strong>Take {take.seed}</strong><span class="badge{"" if take.passed else " failing"}">'
            f'{verdict}</span><span class="badge">{seconds}</span><span class="badge">{_money(take.usd)}</span>'
            f'<a href="{escape(take.tape)}/{escape(take.clip)}">clip</a></figcaption>'
            f'<ul class="checks">{dailies.checklist(failing)}</ul>{passed}</figure>')


def _takes(screen: Screen) -> str:
    sections = []
    for told in screen.stories:
        for key in screen.keys:
            columns = "".join(
                f'<div class="model"><h4>{escape(model)}</h4><div class="takes">'
                + "".join(_take(take) for take in screen.of(model, told) if take.state == key.state.name)
                + "</div></div>" for model in screen.models)
            sections.append(f'<section class="shot sampled" data-story="{escape(told)}" data-key="{escape(key.state.name)}">'
                            f'<h3>{escape(key.state.name)} in {escape(told)}</h3><div class="models">{columns}</div>'
                            "</section>")
    return f'<section id="takes"><h2>Every take</h2>\n{"".join(sections)}\n</section>'


def _calibration(screen: Screen) -> str:
    model, told = CALIBRATION
    takes = [take for take in screen.of(model, told) if not take.refused]
    if not takes:
        return ""
    right = {(mark.clip, mark.element): mark.right for mark in screen.marks}
    figures = []
    for take in takes:
        boxes = "".join(
            f'<li><label><input type="checkbox" class="mark" data-state="{escape(take.state)}" data-seed="{take.seed}" '
            f'data-clip="{escape(take.clip)}" data-place="{element.place}" data-type="{element.type}"'
            f'{" checked" if right.get((take.clip, element.place)) else ""}>'
            f'<span><strong>{element.type}</strong> <span class="lines">'
            f'{escape(" / ".join(element.lines[:4]) + (f" and {len(element.lines) - 4} more" if len(element.lines) > 4 else ""))}'
            "</span></span></label></li>" for element in take.elements)
        figures.append(f'<figure class="take" data-calibration><img src="{escape(take.tape)}/{escape(take.picture)}" '
                       f'alt="The last frame of take {take.seed} of {escape(take.state)}" loading="lazy">'
                       f"<figcaption><strong>{escape(take.state)}</strong> take {take.seed}</figcaption>"
                       f'<ul class="marks">{boxes}</ul></figure>')
    agreed = ""
    if (agreement := screen.agreement) is not None:
        kinds = "".join(f"<li>{kind} {tally}, {tally.share:.1%}</li>"
                        for kind in screen.kinds if (tally := agreement.tally(kind)).of)
        wrong = "".join(
            f"<li>{escape(take.state)} take {take.seed}, {escape(element.named)}: marked "
            f"{'' if mark.right else 'not '}drawn right, and "
            + ("every check of it passes" if element.passed else
               "it fails " + escape(", ".join(f'{i["code"]} {i["about"]}' for i in element.items if not i["passed"])))
            + "</li>" for mark, take, element in agreement.disagreed)
        stale = (f"<p class=\"note\">{_count(agreement.stale, 'mark')} of takes no longer on disk "
                 f"{'is' if agreement.stale == 1 else 'are'} left out.</p>" if agreement.stale else "")
        agreed = (f"<p>{escape(_upper_first(agreement.said()))}.</p><ul>{kinds}</ul>{stale}"
                  + (f"<h3>Where they disagree</h3><ul>{wrong}</ul>" if wrong else ""))
    return f"""<section class="shot" id="calibration" data-model="{escape(model)}" data-story="{escape(told)}">
<h2>Calibration</h2>
<p class="note">Look at each of {escape(model)}'s {len(takes)} takes in {escape(told)}, and tick each element drawn right:
every line of it lettered as written, in its place. Then download marks.json and run the screen test again with
--marks marks.json, which holds the checks to your marks. The page keeps your ticks in this browser.</p>
<p><button type="button" id="download">Download marks.json</button></p>
{agreed}
<div class="takes">
{"".join(figures)}
</div>
</section>"""


def _sources() -> str:
    items = "".join(f'<li><a href="{escape(source.url)}">{escape(source.title)}</a>, {escape(source.date)}. '
                    f"{escape(source.said)}</li>" for source in SOURCES)
    return f"""<section class="shot sources" id="sources">
<h2>Why these models</h2>
<p>{escape(WHY)}</p>
<ul>{items}</ul>
</section>"""


def page(screen: Screen) -> str:
    takes = len(screen.takes)
    spent = sum(screen.spent.values())
    summary = (f"{_count(len(screen.keys), 'key')}, {TAKES} takes each, in {escape(_listed(screen.stories))}, on "
               f"{escape(_listed(screen.models))}: {_count(takes, 'take')}, {_money(spent)} in the ledger.")
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{escape(screen.app)} screen test</title>
<style>{STYLE}</style>
</head>
<body>
<header>
<h1>{escape(screen.app)} screen test</h1>
<p class="summary">{summary}</p>
</header>
<main>
{_pick(screen)}
{_elements(screen)}
{_keys(screen)}
{_calibration(screen)}
{_takes(screen)}
{_sources()}
</main>
<script>{SCRIPT}</script>
</body>
</html>
"""


# The command.

def _models(text: str) -> list[str]:
    names = list(dict.fromkeys(name.strip() for name in text.split(",") if name.strip()))
    unknown = [name for name in names if name not in MODELS]
    if unknown or not names:
        raise argparse.ArgumentTypeError(f"{', '.join(unknown) or 'no model'} is not a model; name models from "
                                         f"{', '.join(sorted(MODELS))}, with a comma between two")
    return names


def _stories(text: str) -> list[str]:
    names = list(dict.fromkeys(name.strip() for name in text.split(",") if name.strip()))
    if not names:
        raise argparse.ArgumentTypeError("names no story; name the stories, with a comma between two, as in "
                                         "terminal,posters")
    return names


def _marks(path: str) -> tuple[Mark, ...]:
    """The marks of a marks.json the report downloaded. ValueError says what is wrong with the file."""
    again = "download it again from the report's Download marks.json button"
    try:
        held = json.loads(Path(path).read_text())
    except OSError as error:
        raise ValueError(f"{path} cannot be read: {error.strerror}; {again}") from None
    except ValueError:
        raise ValueError(f"{path} is not JSON; {again}") from None
    model, told = CALIBRATION
    if not isinstance(held, dict) or not isinstance(held.get("marks"), list):
        raise ValueError(f"{path} holds no marks; {again}")
    if (held.get("model"), held.get("story")) != CALIBRATION:
        raise ValueError(f"{path} holds marks of {held.get('model')}'s {held.get('story')} takes, and the report marks "
                         f"{model}'s {told} takes; {again}")
    shape = {"state": str, "seed": int, "clip": str, "element": int, "type": str, "right": bool}
    for entry in held["marks"]:
        if not isinstance(entry, dict) or set(entry) != set(shape) or not all(
                type(entry[name]) is kind for name, kind in shape.items()):
            raise ValueError(f"{path} holds an entry that is not a mark, {json.dumps(entry)[:120]}; {again}")
    return tuple(Mark(**entry) for entry in held["marks"])


def command(args: argparse.Namespace, cap: float | None) -> str:
    """The command that runs this screen test again, with the cap last. uv runs it in the repository's environment,
    where videotape is installed."""
    words = ["uv", "run", errors.shown(Path(__file__)), args.project, "--models", ",".join(args.models), "--stories",
             ",".join(args.stories)]
    if args.marks:
        words += ["--marks", args.marks]
    return shlex.join([*words, *(["--cap-usd", f"{cap:.2f}"] if cap is not None else [])])


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="scripts/screen-test", description=__doc__.splitlines()[0])
    parser.add_argument("project", help="the app's project, the folder whose pyproject.toml has [tool.videotape]")
    parser.add_argument("--models", required=True, type=_models, help="the models to film the keys with, with a comma "
                        "between two, as in wan3.0,minimax-h3")
    parser.add_argument("--stories", required=True, type=_stories, help="the stories to film the keys in, with a comma "
                        "between two, as in terminal,posters")
    parser.add_argument("--cap-usd", type=float, help="the most the whole screen test may spend on the models' calls "
                        "and the readers' reads")
    parser.add_argument("--estimate", action="store_true", help="print the estimate and stop, before any call; needs no "
                        "API key")
    parser.add_argument("--marks", help="the marks.json the report downloads, whose marks the checks are held to")
    args = parser.parse_args(argv)
    marks = None
    if args.marks is not None:
        try:
            marks = _marks(args.marks)
        except ValueError as error:
            parser.error(f"argument --marks: {error}")
        model, told = CALIBRATION
        if model not in args.models or told not in args.stories:
            parser.error(f"argument --marks: {args.marks} holds marks of {model}'s {told} takes, and this screen test "
                         f"films none; add {model} to --models and {told} to --stories")
    try:
        return _run(args, marks)
    except (ScreenplayError, RenderError) as error:
        print(error.report(), file=sys.stderr)
        return 1


def _run(args: argparse.Namespace, marks: tuple[Mark, ...] | None) -> int:
    found = project.find(Path(args.project).resolve())
    sample = sampled(plan(found.load(), found.max_states))
    told = {name: story.named(found.root, name) for name in args.stories}
    warnings = {warning.report("warning"): None for name in args.models for one in told.values()
                for warning in (*sample.warnings, *story.check(one, sample, MODELS[name].prompt_limit))}
    for warning in warnings:
        print(warning, file=sys.stderr)
    takes = len(SAMPLER) * TAKES * len(told)
    print(f"screen test of {' '.join(filter(None, (found.name, found.version)))}: {_count(len(SAMPLER), 'key')}, "
          f"{TAKES} takes each, in {_listed(list(told))}, on {_listed(args.models)}")
    total = 0.0
    for name in args.models:
        line, usd = estimate(name, MODELS[name], takes)
        print(line)
        total += usd
    cap = args.cap_usd
    fits = "no cap" if cap is None else f"{'under' if total <= cap else 'past'} the cap of ${cap:.2f}"
    print(f"the screen test: {_count(takes * len(args.models), 'take')}, at most ${total:.2f}, {fits}", flush=True)
    if args.estimate:
        return 0
    billed = [*(name for name in args.models if MODELS[name].price),
              *dict.fromkeys(reader.name for name in args.models for reader in MODELS[name].readers if reader.paid)]
    if billed and cap is None:
        raise RenderError("VT402", "before the first call", f"{_listed(billed)} bill{'s' if len(billed) == 1 else ''} "
                          "per call, and no cap is set", "set the most the screen test may spend, as in:\n"
                          f"{command(args, _cents_up(total))}")
    if cap is not None and total > cap:
        raise RenderError("VT402", "before the first call", f"the screen test may cost ${total:.2f}, which passes the "
                          f"cap of ${cap:.2f}", f"run it with a cap of at least ${_cents_up(total):.2f}, as in:\n"
                          f"{command(args, _cents_up(total))}")
    tapes = {(name, one): found.root / FOLDER / name / one for name in args.models for one in told}
    models = {name: MODELS[name].model() for name in args.models}
    readers = {(name, one): [reader(tapes[name, one]) for reader in MODELS[name].readers] for name, one in tapes}
    # The tapes render one after another, each under what the cap leaves after the others' lines in the ledger, so
    # one cap holds for them all.
    for (name, one), tape in tapes.items():
        others = sum(ledger.of(found.root, other).spent() for other in tapes.values() if other != tape)
        try:
            _film(found, sample, told[one], name, models[name], readers[name, one], tape,
                  None if cap is None else cap - others, command(args, cap))
        except EveryTakeRefused as error:
            print(RenderError(error.code, error.place, error.message, f"nothing; the tape's other keys are filmed, and "
                              f"the report counts {_count(len(error.seeds), 'refused take')} against {name}").report(),
                  file=sys.stderr, flush=True)
        except RenderError as error:
            if error.code == "VT403":
                raise RenderError(error.code, error.place, error.message, f"the screen test films only seeds 1 and "
                                  f"{TAKES}, and neither decoded; delete each clip the lines above name, with the files "
                                  "beside it that share its name, and run the screen test again, which films those "
                                  f"seeds anew:\n{command(args, cap)}") from None
            if error.code != "VT402" or cap is None:
                raise
            spent = sum(ledger.of(found.root, other).spent() for other in tapes.values())
            raise RenderError("VT402", error.place, f"the next call would pass the screen test's cap of ${cap:.2f}, "
                              f"with ${spent:.2f} spent on its tapes", "run the screen test again with a higher cap, "
                              f"which resumes, as in:\n{command(args, 2 * cap)}") from None
    spent = {name: sum(ledger.of(found.root, tapes[name, one]).spent() for one in told) for name in args.models}
    taken = gathered(found.root, sample.keys, tapes)
    screen = Screen(sample.title, tuple(args.models), tuple(told), sample.keys, tuple(taken), spent, marks or (),
                    None if marks is None else agreement(marks, taken))
    report = found.root / FOLDER / "report.html"
    write_atomically(report, lambda out: out.write_text(page(screen)))
    print(f"wrote {errors.shown(report)}")
    if screen.agreement is not None:
        print(screen.agreement.said())
    chosen = screen.pick
    if chosen is None:
        print(f"no pick: below {AGREEMENT:.0%}, the checks must be fixed before the pick")
        return 0
    model, story_ = CALIBRATION
    held = "" if screen.agreement is not None else (
        f"; the checks are not yet held to a person's marks, so mark {model}'s {story_} takes in the report and run "
        "again with --marks marks.json")
    print(f"pick: {chosen.model}, with {len(chosen.met)} of {len(screen.kinds)} element types at the bar of {BAR:.0%} in "
          f"every story, {chosen.passing} elements passing every check, {chosen.passing.share:.1%}, "
          f"{_count(chosen.invented, 'control')} invented and ${chosen.usd:.2f} spent{held}")
    print(f'to render with it, set model = "{chosen.model}" in [tool.videotape] in '
          f"{errors.shown(found.root / 'pyproject.toml')}")
    return 0


def _film(found: project.Project, sample: Plan, told: story.Story, name: str, model: Model, readers: list[Reader],
          tape: Path, cap: float | None, resume: str) -> None:
    """Render the sampled keys of one model in one story, both takes of each, under the cap left for its tape."""
    listing = MODELS[name]
    print(f"{name} in {told.name}: {_count(len(sample.keys), 'key')}, {TAKES} takes each, read by {eye(readers)} -> "
          f"{errors.shown(tape)}", flush=True)

    def report(filmed: Filmed) -> None:
        for error in filmed.reported:
            print(error.report(), file=sys.stderr, flush=True)
        verdict = "passed" if filmed.passed else f"fails {' '.join(sorted({f.code for f in filmed.failures}))}"
        filmed_takes = f"{_count(filmed.rendered, 'take')} filmed" if filmed.rendered else "cached"
        print(f"{sample.keys.index(filmed.shot) + 1}. {filmed.shot.title}  kept take {filmed.kept.seed}, {verdict}, "
              f"{filmed_takes}, ${filmed.usd:.2f}, {filmed.seconds:.1f} s", flush=True)

    render(sample, told, model, readers, tape, ledger.of(found.root, tape), made(found, told, model), takes=TAKES,
           limit=listing.limit, price=listing.price, cap=cap, resume=resume, report=report, every=True)

if __name__ == "__main__":
    sys.exit(main())
