def _count(number: int, noun: str) -> str:
    return f"{number} {noun}{'' if number == 1 else 's'}"


def _listed(names: Sequence[str]) -> str:
    return " and ".join(filter(None, (", ".join(names[:-1]), names[-1])))


def _upper_first(text: str) -> str:
    return text[:1].upper() + text[1:]


def _cents_up(usd: float) -> float:
    return math.ceil(round(usd * 100, 6)) / 100


def sampled(planned: Plan) -> Plan:
    """SAMPLER's states as keys, in SAMPLER's order, each drawn from its own prompt as the paid run drew it, whatever
    the plan draws it from, and no move. VT212 for a state the plan lacks."""
    keys = {key.state.name: Key(key.id, key.state, key.shown) for key in planned.keys}
    for name in SAMPLER:
        if name not in keys:
            close = get_close_matches(name, keys, n=3)
            raise ScreenplayError("VT212", f'"{name}"', "the app has no state of this name, and the screen test films "
                                  "its key", f"name one of the closest in SAMPLER in scripts/screen-test: "
                                  f"{', '.join(close)}" if close else "name a state of the plan in SAMPLER in "
                                  "scripts/screen-test, as videotape plan names it")
    return Plan(planned.title, planned.scenes, tuple(keys[name] for name in SAMPLER), (), planned.warnings)


def estimate(name: str, listing: Listing, takes: int) -> tuple[str, float]:
    """One model's line of the estimate and the most it costs: a call per take at the model's price, and a read of
    each take by each paid reader of its eye, at the most a read of the model's picture costs."""
    usd = takes * listing.price.usd if listing.price else 0.0
    line = f"{name}: {_count(takes, 'call')}, {listing.price.span(takes, takes) if listing.price else 'free'}"
    paid = [reader for reader in listing.readers if reader.paid]
    if paid:
        width, height = SIZES.get(name, (WIDTH, HEIGHT))
        reads = takes * sum(reader.most(width, height) for reader in paid)
        line += (f", and {_count(takes, 'read')} by {_listed([reader.name for reader in paid])} of {width}x{height} "
                 f"pictures, at most ${reads:.2f}")
        usd += reads
    return f"{line}; at most ${usd:.2f} in all", usd


# What the report shows.

@dataclass(frozen=True)
class Tally:
    passed: int
    of: int

    @property
    def share(self) -> float:
        return self.passed / self.of if self.of else 0.0

    @property
    def met(self) -> bool:
        return self.of > 0 and self.share >= BAR

    def __str__(self) -> str:
        return f"{self.passed} of {self.of}"


@dataclass(frozen=True)
class Element:
    """One element of a key on one take, and the checks that judge it."""

    place: int
    """Where it is among the key's elements, from 0."""
    type: str
    lines: tuple[str, ...]
    items: tuple[dict, ...]

    @property
    def passed(self) -> bool:
        return all(item["passed"] for item in self.items)

    @property
    def named(self) -> str:
        return f'{self.type} "{self.lines[0]}"' if self.lines else self.type


@dataclass(frozen=True)
class Take:
    """One take of a sampled key, as its tape's dailies and the project's ledger record it."""

    model: str
    story: str
    state: str
    seed: int
    clip: str
    """Where its clip is in its tape."""
    seconds: float | None
    usd: float
    items: tuple[dict, ...]
    elements: tuple[Element, ...]
    refused: bool = False
    """Whether the model refused the take for its content, VT409, so it has no clip, and every element of it counts
    as not drawn right."""

    @property
    def tape(self) -> str:
        """Its tape's folder, from the report's."""
        return f"{self.model}/{self.story}"

    @property
    def picture(self) -> str:
        """Its last frame, which every reader read, from its tape."""
        return f"pictures/{Path(self.clip).stem}.png"

    @property
    def invented(self) -> int:
        return sum(item["code"] == "VT503" for item in self.items)

    @property
    def passed(self) -> bool:
        return all(item["passed"] for item in self.items)


def judged(key: Key, items: Sequence[dict]) -> tuple[Element, ...]:
    """Each element of the key with the checks that judge it. A check names the element type it judges and not
    which element of that type, so each is placed by what it is about: VT501 by its action's label, VT502 by its
    line's words, the second reading of words the key shows twice on the element that shows them second, VT504 by its
    chart's title, VT509 by its chosen line or else on the first element of its type that offers a choice, and a
    VT502 of a day with no option, which has no reading, on the first element of its type. VT503 judges the whole key,
    and no element."""
    shown = key.shown
    actions = {line.action.label: place for place, element in enumerate(shown) for line in element.lines if line.action}
    charts = {element.chart.title: place for place, element in enumerate(shown) if element.chart}
    words: dict[str, list[int]] = {}
    for place, element in enumerate(shown):
        for line in element.lines:
            words.setdefault(line.words, []).append(place)
    choosing = [place for place, element in enumerate(shown) if any(
        line.chosen or (line.action is not None and line.action.kind in CHOICES) for line in element.lines)]
    read = Counter[str]()

    def first(kind: str, among: Sequence[int] = range(len(shown))) -> int | None:
        return next((place for place in among if shown[place].type == kind), None)

    def place(item: dict) -> int | None:
        code, about, kind = item["code"], item["about"], item["element"]
        if kind is None:
            return None
        if code == "VT501":
            return actions.get(about)
        if code == "VT504":
            return charts.get(about)
        if code == "VT502" and item["readings"] and about in words:
            read[about] += 1
            return words[about][min(read[about], len(words[about])) - 1]
        if code == "VT509":
            return next((at for at in words.get(about, []) if at in choosing), first(kind, choosing))
        return first(kind)

    placed: dict[int, list[dict]] = {place: [] for place in range(len(shown))}
    for item in items:
        if (at := place(item)) is not None:
            placed[at].append(item)
    return tuple(Element(at, element.type, tuple(line.words for line in element.lines), tuple(placed[at]))
                 for at, element in enumerate(shown))


@dataclass(frozen=True)
class Standing:
    """How one model did: the element types at the bar in every story, its elements that pass every check in every
    story, the controls its takes invent, as each reader saw them, and what its takes and reads cost."""

    model: str
    met: frozenset[str]
    passing: Tally
    invented: int
    usd: float


def pick(standings: Sequence[Standing]) -> Standing:
    """The most element types at the bar, then the largest share of elements that pass every check, which decides
    while no type meets the bar, then the fewest controls invented, then the lowest cost."""
    return min(standings, key=lambda standing: (-len(standing.met), -standing.passing.share, standing.invented,
                                                standing.usd))


@dataclass(frozen=True)
class Mark:
    """A person's mark of one element of one take: whether it is drawn right."""

    state: str
    seed: int
    clip: str
    element: int
    type: str
    right: bool


@dataclass(frozen=True)
class Agreement:
    """The checks' verdict on each element a person marked, against the mark, and the marks of takes not on disk."""

    agreed: tuple[tuple[Mark, Take, Element], ...]
    disagreed: tuple[tuple[Mark, Take, Element], ...]
    stale: int

    def tally(self, kind: str | None = None) -> Tally:
        agreed = sum(kind in (None, element.type) for _, _, element in self.agreed)
        return Tally(agreed, agreed + sum(kind in (None, element.type) for _, _, element in self.disagreed))

    @property
    def held(self) -> bool:
        whole = self.tally()
        return whole.of > 0 and whole.share >= AGREEMENT

    def said(self) -> str:
        whole = self.tally()
        return f"the checks agree with a person's marks on {whole} elements, {whole.share:.1%}"


def agreement(marks: Sequence[Mark], takes: Sequence[Take]) -> Agreement:
    """Each mark against the checks' verdict on its element: every check that judges it passed. A mark is of a take
    by its clip, since a take filmed again keeps its seed and gets new pixels."""
    model, told = CALIBRATION
    held = {(take.state, take.clip): take for take in takes if (take.model, take.story) == (model, told)}
    agreed, disagreed, stale = [], [], 0
    for mark in marks:
        take = held.get((mark.state, mark.clip))
        if take is None or not 0 <= mark.element < len(take.elements):
            stale += 1
            continue
        element = take.elements[mark.element]
        (agreed if element.passed == mark.right else disagreed).append((mark, take, element))
    return Agreement(tuple(agreed), tuple(disagreed), stale)


@dataclass(frozen=True)
class Screen:
    """What the report shows: the app, the models and stories filmed, the sampled keys, every take, what each
    model's tapes cost, and a person's marks with the checks' agreement, when there are marks."""

    app: str
    models: tuple[str, ...]
    stories: tuple[str, ...]
    keys: tuple[Key, ...]
    takes: tuple[Take, ...]
    spent: dict[str, float]
    marks: tuple[Mark, ...] = ()
    agreement: Agreement | None = None

    @cached_property
    def kinds(self) -> tuple[str, ...]:
        """Every element type the sampled keys show, in the order they first show them."""
        return tuple(dict.fromkeys(element.type for key in self.keys for element in key.shown))

    def of(self, model: str, told: str) -> list[Take]:
        return [take for take in self.takes if (take.model, take.story) == (model, told)]

    def tally(self, model: str, told: str, kind: str) -> Tally:
        elements = [element for take in self.of(model, told) for element in take.elements if element.type == kind]
        return Tally(sum(element.passed for element in elements), len(elements))

    def checks(self, model: str, told: str, kind: str) -> dict[str, Tally]:
        """Each check that judges an element of this type, and how many of its items passed."""
        items = [item for take in self.of(model, told) for element in take.elements if element.type == kind
                 for item in element.items]
        return {code: Tally(sum(item["passed"] for item in items if item["code"] == code),
                            sum(item["code"] == code for item in items)) for code in CODES}

    @cached_property
    def standings(self) -> tuple[Standing, ...]:
        return tuple(Standing(model, frozenset(kind for kind in self.kinds if all(
            self.tally(model, told, kind).met for told in self.stories)),
            Tally(sum(element.passed for take in self.takes if take.model == model for element in take.elements),
                  sum(len(take.elements) for take in self.takes if take.model == model)),
            sum(take.invented for take in self.takes if take.model == model), self.spent[model])
            for model in self.models)

    @property
    def pick(self) -> Standing | None:
        """The pick, or None while the checks agree with too few of a person's marks."""
        return None if self.agreement is not None and not self.agreement.held else pick(self.standings)

    def first_takes(self, model: str, told: str) -> Tally:
        """The keys whose first take, its lowest seed, passes every check."""
        firsts: dict[str, Take] = {}
        for take in self.of(model, told):
            if take.state not in firsts or take.seed < firsts[take.state].seed:
                firsts[take.state] = take
        return Tally(sum(take.passed for take in firsts.values()), len(firsts))

    def best(self, kind: str) -> tuple[str, str, Tally]:
        """The model that brings an element type nearest its bar, its weaker story, and that story's tally."""
        weakest = [(model, *min(((told, self.tally(model, told, kind)) for told in self.stories),
                                key=lambda pair: pair[1].share)) for model in self.models]
        return max(weakest, key=lambda found: found[2].share)


def refusal(key: Key) -> tuple[tuple[dict, ...], tuple[Element, ...]]:
    """A refused take's checks: one failing VT409 for the take and one for each element of its key, so a model is
    not rewarded for the takes it refuses."""
    def failed(about: str, element: str | None) -> dict:
        return {"code": "VT409", "about": about, "result": "refused for its content", "passed": False, "box": None,
                "element": element, "readings": []}
    elements = tuple(Element(at, element.type, tuple(line.words for line in element.lines),
                             (failed(element.type, element.type),)) for at, element in enumerate(key.shown))
    return (failed("the take", None), *(item for element in elements for item in element.items)), elements


def gathered(root: Path, keys: Sequence[Key], tapes: dict[tuple[str, str], Path]) -> list[Take]:
    """Every take of the tapes, from each tape's dailies, with its cost from the project's ledger: its call and its
    reads. Each take's last frame is written into its tape's pictures/, once for each time the take is filmed."""
    by_state = {key.state.name: key for key in keys}
    by_title = {key.title: key for key in keys}
    takes = []
    for (model, told), tape in tapes.items():
        costs = Counter[tuple[str, int]]()
        for line in ledger.of(root, tape).lines():
            if "shot" in line and "seed" in line:
                costs[line["shot"], line["seed"]] += line.get("usd") or 0.0
        held = dailies.read(tape)
        refused = [(by_title[title], seed) for title, seeds in held.get("unfilmed", {}).items() for seed in seeds]
        for key in held["keys"]:
            for filmed in key["takes"]:
                take = Take(model, told, key["state"], filmed["seed"], filmed["clip"], filmed["seconds"],
                            costs[key["title"], filmed["seed"]], tuple(filmed["items"]),
                            judged(by_state[key["state"]], filmed["items"]))
                picture, clip = tape / take.picture, tape / take.clip
                if not picture.is_file() or picture.stat().st_mtime < clip.stat().st_mtime:
                    picture.parent.mkdir(exist_ok=True)
                    write_atomically(picture, lambda out: frames.write_png(frames.last_frame(clip), out))
                takes.append(take)
            refused += [(by_state[key["state"]], seed) for seed in key.get("refused", [])]
        for key, seed in refused:
            items, elements = refusal(key)
            takes.append(Take(model, told, key.state.name, seed, "", None, costs[key.title, seed], items, elements,
                              refused=True))
    return takes


# The report's page.

