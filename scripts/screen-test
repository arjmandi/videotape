#!/usr/bin/env python3
"""Film eight keys of an app on each model, two takes each in each story, and pick the model whose takes pass the
checks for the most element types.

    uv run scripts/screen-test examples/contrail --models wan3.0,minimax-h3,gemini-omni-flash-1.2 \\
        --stories terminal,posters --cap-usd 60 [--estimate] [--marks marks.json]
    open examples/contrail/tapes/screen-test/report.html

The eight keys are SAMPLER's, which hold every element type Contrail shows. Before any call it prints the estimate:
per model, a call per take at the model's price on fal, and a read of each take by each paid reader of its eye at the
most a read of the model's picture costs, then the total. --estimate prints it and stops, and needs no API key. A
total past --cap-usd stops it before any call. Then it builds every model and reader, so a missing API key stops it
with VT104 before any call, and renders each model in each story into tapes/screen-test/<model>/<story>/ in the
project: the sampled keys alone, no move, and both takes of each even when the first passes. One cap holds for the
whole screen test, and every call and read goes into the project's ledger.jsonl, as a render's do. Run again, it
films no take that is on disk and reads no picture whose read is cached, so the report is rebuilt for free.

tapes/screen-test/report.html shows, for each element type, model and story, how many of its elements pass every
check that judges them, and each check's count; the controls each key invents; the first-take yield; every take with
its picture, its checks, its time and its cost, with the models side by side for each key; and the sources for the
choice of models. CALIBRATION's takes each list their key's elements with a checkbox, drawn right or not, and the page
downloads them as marks.json. --marks marks.json reads them back and says how often the checks' verdict on an element,
that every check judging it passed, agrees with a person's mark. Below AGREEMENT the pick is withheld. Otherwise the
pick is the model with the most element types at BAR in every story, then the largest share of elements that pass
every check, then the fewest controls invented, then the lowest cost. It is printed, and pyproject.toml is left as it is.

Standard library only; it imports videotape.
"""

from __future__ import annotations

import argparse
import json
import math
import shlex
import sys
from collections import Counter
from collections.abc import Sequence
from dataclasses import dataclass
from difflib import get_close_matches
from functools import cached_property
from html import escape
from pathlib import Path

from videotape import dailies, errors, frames, ledger, project, story
from videotape.atomic import write_atomically
from videotape.errors import RenderError, ScreenplayError
from videotape.frames import HEIGHT, WIDTH
from videotape.made import made
from videotape.checks import CHOICES, Reader
from videotape.model import MODELS, SIZES, Listing, Model
from videotape.plan import Key, Plan, plan
from videotape.render import EveryTakeRefused, Filmed, eye, render

SAMPLER = ("home()", "search()", "dates(JFK)", "results(SEA, 2026-12-12)", "flight(CT 104, 2026-12-13)",
           "booked(CT 300, 2026-12-11)", "my_trips()", "profile()")
"""The states whose keys the screen test films. Together they show every element type Contrail has."""
TAKES = 2
BAR = 0.9
"""An element type meets its bar on a model when, in each story, at least this share of its elements across the
model's takes pass every check that judges them."""
AGREEMENT = 0.9
"""The least share of a person's marks the checks must agree with before the report names a pick."""
CALIBRATION = ("wan3.0", "terminal")
"""The model and the story whose takes a person marks, element by element."""
CODES = {"VT501": "found", "VT502": "read exactly by every reader", "VT509": "drawn marked",
         "VT504": "chart values in range"}
"""The checks that judge an element, in the order the report shows them. VT503 judges a whole key."""
FOLDER = Path("tapes") / "screen-test"
"""Where the tapes and the report go, in the project."""
@dataclass(frozen=True)
class Source:
    title: str
    url: str
    date: str
    said: str


