{
  "name": "videotape-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:player": "pnpm --filter @videotape/player build",
    "check": "node packages/cli/bin/videotape.mjs check apps/site",
    "dev": "node packages/cli/bin/videotape.mjs dev apps/site",
    "serve": "node packages/cli/bin/videotape.mjs serve apps/site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/ws": "^8.18.2",
    "tsx": "^4",
    "typescript": "~5.9",
    "vitest": "^3.2",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.0"
    }
  }
}
